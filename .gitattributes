# Normaliza as quebras de linha: no repositório tudo fica com LF.
* text=auto eol=lf

# Arquivos que o Windows espera com CRLF
*.sln   text eol=crlf
*.slnx  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf
*.ps1   text eol=crlf

# Binários: o git não deve mexer no conteúdo
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
