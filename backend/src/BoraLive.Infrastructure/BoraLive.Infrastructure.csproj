<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BoraLive.Application\BoraLive.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageReference Include="SkiaSharp" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Os modelos em JSON vão embutidos dentro da DLL: não dependem de caminho de pasta. -->
    <EmbeddedResource Include="Templates/Data/**/*.json" />
    <!-- As fontes também vão embutidas: o container Linux não tem fonte instalada. -->
    <EmbeddedResource Include="Imaging/Fonts/*.ttf" />
  </ItemGroup>

</Project>
